---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

import "@/styles/global.css";

import { SITE_DATA, SITE_LOCALE } from '@/lib/site.ts';
import { TEXTS_GENERAL } from '@/lib/texts.ts';
import faviconUrl from '@/assets/icon.svg?url';

export interface Props {
    title: string;
    description?: string;
    canonical?: string;
}

const {
    title,
    description = SITE_DATA.description,
    canonical,
} = Astro.props;
if (!Astro.site) throw new Error(TEXTS_GENERAL.errors.siteConfiguration);
const canonicalURL = new URL(canonical ?? Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang={SITE_LOCALE.html} class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" sizes="any" href={faviconUrl} />
        <meta name="color-scheme" content="light dark" />
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <title>{SITE_DATA.name} | {title}</title>
    </head>
    <body
        class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 bg-background-dark text-white"
    >
        <Header />
        <slot />
        <Footer />
    </body>
</html>
