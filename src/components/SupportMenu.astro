---
import { SUPPORT_LINKS } from '@/lib/links.ts';
import { TEXTS_GENERAL } from '@/lib/texts.ts';
---

<button
    type="button"
    popovertarget="support-popover"
    class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-4 py-2 text-sm font-medium text-secondary transition hover:bg-primary/20 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary"
>
    <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 fill-none stroke-current" stroke-width="1.75">
        <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    {TEXTS_GENERAL.header.supportButton}
</button>

<div
    id="support-popover"
    popover="auto"
    aria-labelledby="support-title"
    class="support-popover rounded-3xl border border-primary/30 bg-slate-950/95 p-5 text-white shadow-2xl backdrop-blur"
>
    <div class="flex items-center justify-between gap-4">
        <h2 id="support-title" class="text-lg font-semibold text-secondary">{TEXTS_GENERAL.header.supportTitle}</h2>
        <button
            type="button"
            popovertarget="support-popover"
            popovertargetaction="hide"
            aria-label={TEXTS_GENERAL.common.close}
            class="rounded-full p-2 text-slate-300 transition hover:bg-primary/20 focus-visible:outline-2 focus-visible:outline-secondary"
        >
            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 fill-none stroke-current" stroke-width="2">
                <path d="m6 6 12 12M18 6 6 18" stroke-linecap="round" />
            </svg>
        </button>
    </div>
    <p class="mt-2 text-sm leading-6 text-slate-300">{TEXTS_GENERAL.header.supportDescription}</p>
    <ul class="mt-4 space-y-2">
        {SUPPORT_LINKS.map((link) => (
            <li>
                <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center justify-between gap-3 rounded-2xl border border-primary/25 bg-primary/10 px-4 py-3 text-sm font-medium text-secondary transition hover:bg-primary/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary"
                >
                    {link.label}
                    <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 fill-none stroke-current" stroke-width="1.75">
                        <path d="M7 17 17 7M7 7h10v10" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </a>
            </li>
        ))}
    </ul>
</div>

<style>
    .support-popover {
        position: fixed;
        inset: 6rem auto auto 50%;
        margin: 0;
        width: min(22rem, calc(100vw - 2rem));
        max-height: calc(100dvh - 7rem);
        overflow-y: auto;
        transform: translateX(-50%);
    }
</style>
