---
import { SITE_DATA } from '@/lib/site.ts';
import { HEADER_LINKS } from '@/lib/links.ts';
import SupportMenu from '@/components/SupportMenu.astro';

import GitHubIcon from "@/assets/github.svg";
import UserIcon from "@/assets/user.svg";
---

<header>
    <nav class="flex flex-row flex-wrap justify-center items-center gap-x-4 gap-y-2 mt-4">
        <a
            href={HEADER_LINKS.repository.href}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-md p-2 hover:bg-secondary/30 transition-colors duration-300"
        >
            <span class="flex justify-center items-center gap-2">
                <GitHubIcon />{HEADER_LINKS.repository.label}</span
            >
        </a>
        <h2
            class="text-2xl font-extrabold tracking-tight leading-none text-center"
        >
            <span>{SITE_DATA.name.split(" ")[0]}</span>
            <span class="text-primary">
                {SITE_DATA.name.split(" ").slice(1).join(" ")}</span
            >
        </h2>
        <a
            href={HEADER_LINKS.aboutMe.href}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-md p-2 hover:bg-secondary/30 transition-colors duration-300"
        >
            <span class="flex justify-center items-center gap-2">
                <UserIcon />{HEADER_LINKS.aboutMe.label}</span
            >
        </a>
        <SupportMenu />
    </nav>
</header>
