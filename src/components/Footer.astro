---
import { TEXTS_GENERAL } from '@/scripts/catalog/texts.ts';
import { SITE_DATA, SOCIAL_DATA, currentYear } from "@/scripts/catalog/data.js";

import LinkedInIcon from "@/assets/linkedin.svg";
import GitHubIcon from "@/assets/github.svg";
import HackTheBoxIcon from "@/assets/hackthebox.svg";
import MailIcon from "@/assets/email.svg";
import XIcon from "@/assets/x.svg";

import AstroIcon from "@/assets/astro.svg";
import TailwindIcon from "@/assets/tailwind.svg";
import ReactIcon from "@/assets/react.svg";
import OpenRouterIcon from "@/assets/openrouter.svg";
import VirusTotalIcon from "@/assets/virustotal.svg";
import LinkIcon from "@/assets/link.svg";
---

<footer
    class="flex flex-col justify-center items-center border-t border-slate-800 mb-4 max-w-4xl mx-auto"
>
    <!-- Logo y descripción -->
    <article
        class="my-6 grid w-full grid-cols-1 gap-8 justify-items-center md:grid-cols-[1fr_auto] md:items-start"
    >
        <div class="flex flex-col items-center text-center">
            <h2 class="text-xl font-bold text-wrap">
                {TEXTS_GENERAL.hackathonTitle}
            </h2>
            <p class="text-balance mt-4 max-w-xl">
                {SITE_DATA.description}
            </p>

            <div class="flex gap-5 items-center justify-center mt-2">
                {
                    SOCIAL_DATA.map((social) => {
                        return (
                            <a
                                id={`link-${social.id}`}
                                href={social.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label={social.name}
                                class="hover:text-secondary/90 transition duration-100 ease-in-out"
                            >
                                {social.id === "linkedin" && <LinkedInIcon />}
                                {social.id === "github" && <GitHubIcon />}
                                {social.id === "hackthebox" && (
                                    <HackTheBoxIcon />
                                )}
                                {social.id === "x" && <XIcon />}
                                {social.id === "email" && <MailIcon />}
                            </a>
                        );
                    })
                }
            </div>
        </div>
        <div class="w-full md:min-w-100">
            <h2 class="text-xl font-bold text-center">{TEXTS_GENERAL.poweredBy}</h2>
            <ul class="powered-grid mt-4">
                <li class="justify-self-center">
                    <a
                        href="https://cubepath.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 hover:text-secondary/90 transition duration-100 ease-in-out"
                    >
                        <LinkIcon />
                        <span>{TEXTS_GENERAL.brands.cubepath}</span>
                    </a>
                </li>
                <li class="justify-self-center">
                    <a
                        href="https://astro.build"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 hover:text-secondary/90 transition duration-100 ease-in-out"
                    >
                        <AstroIcon />
                        <span>{TEXTS_GENERAL.brands.astro}</span>
                    </a>
                </li>
                <li class="justify-self-center">
                    <a
                        href="https://react.dev"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 hover:text-secondary/90 transition duration-100 ease-in-out"
                    >
                        <ReactIcon />
                        <span>{TEXTS_GENERAL.brands.react}</span>
                    </a>
                </li>
                <li class="justify-self-center">
                    <a
                        href="https://tailwindcss.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 hover:text-secondary/90 transition duration-100 ease-in-out"
                    >
                        <TailwindIcon />
                        <span>{TEXTS_GENERAL.brands.tailwind}</span>
                    </a>
                </li>
                <li class="justify-self-center">
                    <a
                        href="https://openrouter.ai"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 hover:text-secondary/90 transition duration-100 ease-in-out"
                    >
                        <OpenRouterIcon />
                        <span>{TEXTS_GENERAL.brands.openrouter}</span>
                    </a>
                </li>
                <li class="justify-self-center">
                    <a
                        href="https://www.virustotal.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 hover:text-secondary/90 transition duration-100 ease-in-out"
                    >
                        <VirusTotalIcon />
                        <span>{TEXTS_GENERAL.brands.virustotal}</span>
                    </a>
                </li>
                <li class="justify-self-center">
                    <a
                        href="https://www.abuseipdb.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 hover:text-secondary/90 transition duration-100 ease-in-out"
                    >
                        <LinkIcon />
                        <span>{TEXTS_GENERAL.brands.abuseipdb}</span>
                    </a>
                </li>
                <li class="justify-self-center">
                    <a
                        href="https://polyswarm.io"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 hover:text-secondary/90 transition duration-100 ease-in-out"
                    >
                        <LinkIcon />
                        <span>{TEXTS_GENERAL.brands.polyswarm}</span>
                    </a>
                </li>
                <li class="justify-self-center">
                    <a
                        href="https://www.robtex.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 hover:text-secondary/90 transition duration-100 ease-in-out"
                    >
                        <LinkIcon />
                        <span>{TEXTS_GENERAL.brands.robtex}</span>
                    </a>
                </li>
            </ul>
        </div>
    </article>

    <div class="text-center">
        © {currentYear}. {TEXTS_GENERAL.licenseNotice} <a
            href="https://github.com/marcvspt/cyberthreat-ai/blob/master/LICENSE"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-secondary/90 transition duration-100 ease-in-out"
            ><strong>{TEXTS_GENERAL.licenseName}</strong></a
        >.
    </div>
</footer>

<style>
    .powered-grid {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 0.75rem 1rem;
    }

    .powered-grid > li {
        grid-column: span 2;
    }

    /* Si sobra 1 elemento en la última fila, ocupa todo el ancho */
    .powered-grid > li:nth-last-child(1):nth-child(3n + 1) {
        grid-column: 1 / -1;
    }

    /* Si sobran 2 elementos, se centran con menos separación */
    .powered-grid > li:nth-last-child(2):nth-child(3n + 1) {
        grid-column: 2 / span 2;
    }

    .powered-grid > li:nth-last-child(1):nth-child(3n + 2) {
        grid-column: 4 / span 2;
    }
</style>
