---
import LayoutBase from "@/layouts/LayoutBase.astro";

import App from "@/components/App.tsx";
---

<LayoutBase title="Inicio">
	<main class="py-8">
		<h1 class="text-center text-wrap text-3xl text-secondary font-semibold">
			¡Comienza tu <span class="text-primary font-bold"
				>investigación de indicadores</span
			> de compromiso a través de <span class="text-primary font-bold"
				>modelos LLM</span
			>!
		</h1>
		<App client:load />
	</main>
</LayoutBase>
