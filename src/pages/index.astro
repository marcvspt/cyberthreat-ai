---
import { TEXTS_GENERAL } from '@/lib/texts.ts';
import BaseLayout from "@/layouts/BaseLayout.astro";

import App from "@/components/App.tsx";
---

<BaseLayout title={TEXTS_GENERAL.home.title}>
	<main class="py-8">
		<h1 class="text-center text-wrap text-3xl text-secondary font-semibold">
			{TEXTS_GENERAL.home.heroStart}<span class="text-primary font-bold"
				>{TEXTS_GENERAL.home.heroIndicators}</span
			>{TEXTS_GENERAL.home.heroBridge}<span class="text-primary font-bold"
				>{TEXTS_GENERAL.home.heroModels}</span
			>{TEXTS_GENERAL.home.heroEnd}
		</h1>
		<App client:load />
	</main>
</BaseLayout>
